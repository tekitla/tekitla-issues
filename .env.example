# Variables de entorno de issues-service para desarrollo local.
#
#   cp .env.example .env.dev    # .env.dev está en .gitignore
#
# En desarrollo (APP_ENV vacío o "development") el servicio carga .env.dev
# automáticamente, buscándolo hacia arriba desde el CWD. ENV_FILE=<ruta> fuerza
# otro archivo.
#
# Son las MISMAS variables en todos los destinos (12-factor): docker-compose.yml
# (local), el panel de Coolify (docker-compose.coolify.yml).
# Cambiar de destino no toca el código, solo dónde se cargan los valores.
#
# NUNCA pongas credenciales reales en este archivo: se commitea.

APP_ENV=development
SERVICE_ENV=dev
DEBUG=true
LOG_LEVEL=debug

GRPC_PORT=5000

# Postgres local (`docker compose up -d --wait postgres`). Formato: postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

OTEL_SERVICE_NAME=issues-service
OTEL_RESOURCE_ATTRIBUTES=service.version=dev,deployment.environment=dev
